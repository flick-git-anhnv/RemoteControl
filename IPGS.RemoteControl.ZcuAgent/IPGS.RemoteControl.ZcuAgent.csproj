<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IPGS.RemoteControl.ZcuAgent</RootNamespace>
    <AssemblyName>IPGS.RemoteControl.ZcuAgent</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Link Protocol source files from CcuClient so both assemblies share the same
    message format without a project reference. TDD §4 / Handoff Log.
  -->
  <ItemGroup>
    <Compile Include="..\IPGS.RemoteControl.CcuClient\Protocol\ProtocolException.cs"
             Link="Protocol\ProtocolException.cs" />
    <Compile Include="..\IPGS.RemoteControl.CcuClient\Protocol\MessageTypes.cs"
             Link="Protocol\MessageTypes.cs" />
    <Compile Include="..\IPGS.RemoteControl.CcuClient\Protocol\MessageCodec.cs"
             Link="Protocol\MessageCodec.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SkiaSharp for JPEG encoding (TDD §6.3). NativeAssets.Linux provides the .so on publish. -->
    <PackageReference Include="SkiaSharp"                   Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />

    <!-- Generic Host + DI + Configuration + Logging -->
    <PackageReference Include="Microsoft.Extensions.Hosting"              Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json"   Version="8.0.1" />

    <!--
      Tmds.DBus: talks to GNOME Shell's private org.gnome.Mutter.ScreenCast /
      org.gnome.Mutter.RemoteDesktop D-Bus interfaces on the user session bus for
      Wayland capture + input injection (Wayland/ folder). Version pinned to the
      classic reflection-based CreateProxy<T> API (pre-0.90 rewrite).
    -->
    <!-- 0.92.0 is the first Tmds.DBus release with the GHSA-xrw6-gwf8-vvr9 fix (0.21.x line
         only got the fix in Tmds.DBus.Protocol, not this package). Still uses the classic
         reflection-based CreateProxy<T> API used throughout Wayland/. -->
    <PackageReference Include="Tmds.DBus" Version="0.92.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
