<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IPGS.RemoteControl.CcuUI.ViewModels"
        xmlns:views="using:IPGS.RemoteControl.CcuUI.Views"
        xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
        x:Class="IPGS.RemoteControl.CcuUI.Views.RemoteScreenWindow"
        x:DataType="vm:RemoteScreenViewModel"
        Title="Remote Control — ZCU"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="480"
        Background="#1A1A2E">

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- ─── Row 0: Status / control bar ─────────────────────────────── -->
    <Border Grid.Row="0"
            Background="#251C53"
            Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">

        <!-- Status dot + status text -->
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">

          <Ellipse Width="10" Height="10"
                   VerticalAlignment="Center"
                   Fill="{Binding StatusBrush}" />

          <TextBlock Text="{Binding StatusText}"
                     Foreground="White"
                     FontSize="13"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Disconnect — enabled only while streaming -->
        <kz:KzButton Grid.Column="1"
                     Name="BtnDisconnect"
                     Content="Ngắt kết nối"
                     IsEnabled="{Binding IsStreaming}"
                     Click="OnDisconnectClick"
                     Margin="8,0,0,0" />
      </Grid>
    </Border>

    <!-- ─── Row 1: SSH Installation Guide ────────────────────────────── -->
    <Border Grid.Row="1"
            Background="#F0F9FF"
            BorderBrush="#BAE6FD"
            BorderThickness="0,0,0,1"
            Padding="12,8"
            IsVisible="{Binding ShowSshHelp}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="💡 Cài SSH (nếu máy chưa có):"
                   Foreground="#0369A1"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <TextBlock Text="Mở Terminal trên màn hình Kiosk bên dưới và gõ:"
                   Foreground="#0284C7"
                   VerticalAlignment="Center" />
        <TextBox Text="sudo apt update &amp;&amp; sudo apt install openssh-server -y"
                 IsReadOnly="True"
                 Background="#FFFFFF"
                 Foreground="#0F172A"
                 BorderBrush="#BAE6FD"
                 BorderThickness="1"
                 CornerRadius="4"
                 Padding="8,4"
                 FontFamily="Consolas, Cascadia Code, Monospace"
                 VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- ─── Row 2: Error banner — visible when Faulted ───────────────── -->
    <Border Grid.Row="2"
            Background="#C0390B"
            Padding="12,8"
            IsVisible="{Binding IsFaulted}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠"
                   Foreground="White"
                   FontSize="14"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="White"
                   FontSize="13"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- ─── Row 3: Remote screen (fills remaining space) ─────────────── -->
    <!--
      DataContext is inherited from the Window (RemoteScreenViewModel),
      so RemoteScreenControl receives the same ViewModel automatically.
    -->
    <views:RemoteScreenControl Grid.Row="3"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />

  </Grid>

</Window>
