<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
        xmlns:views="clr-namespace:IPGS.RemoteControl.CcuUI.Views"
        x:Class="IPGS.RemoteControl.CcuUI.Views.RemoteCommandWindow"
        Title="Quản lý File &amp; Lệnh (SFTP / SSH)"
        Width="1000" Height="720"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0" Background="#251C53" Padding="20,16">
      <StackPanel Spacing="4">
        <TextBlock Text=">_ Quản lý File &amp; Lệnh (SFTP / SSH)"
                   Foreground="White" FontSize="16" FontWeight="Bold" />
        <TextBlock x:Name="PART_TargetHostText" Text="Đang kết nối: —" Foreground="#B8B3D6" FontSize="12" />
      </StackPanel>
    </Border>

    <!-- Content (Tabs) -->
    <TabControl Grid.Row="1" Margin="8">
      
      <!-- TAB 1: Console / CMD -->
      <TabItem Header=">_ Console (CMD)">
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="16,16">
            
            <StackPanel Spacing="4">
              <TextBlock Text="Sudo password (nếu lệnh cần quyền sudo, để trống nếu giống SSH password):" FontSize="12" Foreground="#64748B"/>
              <TextBox x:Name="PART_SudoPassword" PasswordChar="•" Height="36" />
            </StackPanel>

            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Nhập lệnh bash/shell cần thực thi:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                <AutoCompleteBox x:Name="PART_SnippetCombo" PlaceholderText="Nhập từ khóa (vd: Reboot, RAM)..." Width="300" SelectionChanged="OnSnippetSelectionChanged" FilterMode="Contains" MinimumPrefixLength="0" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="PART_CommandInput" Grid.Column="0" Margin="0,0,8,0" Height="80" AcceptsReturn="True" TextWrapping="Wrap" />
                <Button x:Name="PART_BtnRunCommand" Content="🚀 Chạy lệnh" Grid.Column="1" Padding="16,8" Foreground="White" Background="#10B981" />
              </Grid>
            </StackPanel>

            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="💻 Kết quả trả về (Console Output):" Foreground="#475569" FontSize="13" FontWeight="SemiBold"/>
                <TextBox x:Name="PART_LogConsole"
                         Height="340"
                         Padding="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="#FFFFFF"
                         Foreground="#334155"
                         FontFamily="Consolas, Cascadia Code, Monospace"
                         FontSize="13"
                         BorderThickness="1"
                         BorderBrush="#CBD5E1"
                         CornerRadius="6"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- TAB 2: File Transfer -->
      <TabItem Header="📁 Truyền nhận File (SFTP)">
        <Grid RowDefinitions="Auto,Auto,*" Margin="8">
          
          <!-- Hint Alert -->
          <Border Grid.Row="0" Background="#FFF9C4" BorderBrush="#FFF59D" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical" Spacing="4">
              <TextBlock Text="💡 Quản lý File Chuyên Sâu: Duyệt file hiển thị theo dạng danh sách tương tự File Explorer. Đã hỗ trợ Drag &amp; Drop (Kéo/Thả) nhiều file cùng lúc thẳng từ máy cá nhân vào thư mục đích." TextWrapping="Wrap" FontSize="12" Foreground="#E65100"/>
              <TextBlock Text="🔄 Đồng Bộ Folder (Sync): Bấm nút để chọn một thư mục trên máy trạm của bạn, phần mềm sẽ đối chiếu và cập nhật những file bị thay đổi lên đúng thư mục trên máy đích (ZCU)." TextWrapping="Wrap" FontSize="12" Foreground="#E65100"/>
            </StackPanel>
          </Border>

          <!-- File Toolbar -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <Button x:Name="PART_BtnFileUpDir" Grid.Column="0" Content="⬆️ Lên" ToolTip.Tip="Lên thư mục cha" Margin="0,0,8,0" />
            <TextBox x:Name="PART_FileCurrentPath" Grid.Column="1" Margin="0,0,8,0" KeyDown="OnFileCurrentPathKeyDown" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
               <Button x:Name="PART_BtnFileRefresh" Content="🔄 Tải lại" ToolTip.Tip="Làm mới danh sách file/thư mục (F5)" />
               <Button x:Name="PART_BtnFileSync" Content="🔄 Sync (Local &gt; Remote)" Background="#8B5CF6" Foreground="White" ToolTip.Tip="Đồng bộ tất cả các file có thay đổi từ máy trạm lên thư mục đích trên ZCU" />
               <Button x:Name="PART_BtnFileUpload" Content="📤 Upload File" Background="#10B981" Foreground="White" ToolTip.Tip="Tải file từ máy tính của bạn lên thư mục hiện tại trên ZCU (Có thể kéo thả)" />
               <Button x:Name="PART_BtnFileDownload" Content="📥 Download" Background="#3B82F6" Foreground="White" ToolTip.Tip="Tải file/thư mục đang chọn từ ZCU về máy tính của bạn" />
               <Button x:Name="PART_BtnFileDelete" Content="🗑️ Xóa" Background="#EF4444" Foreground="White" ToolTip.Tip="Xóa các file/thư mục đang chọn khỏi ZCU (Delete)" />
            </StackPanel>
          </Grid>

          <!-- File ListBox -->
          <ListBox Grid.Row="2" x:Name="PART_FileListBox"
                   BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                   SelectionMode="Multiple"
                   DoubleTapped="OnFileItemDoubleTapped"
                   DragDrop.AllowDrop="True">
             <ListBox.ItemTemplate>
                <DataTemplate x:DataType="views:RemoteFileItem">
                   <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
                      <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" Width="20" TextAlignment="Center" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="{Binding FontWeight}" Width="350" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Width="100" />
                      <TextBlock Text="{Binding LastModified, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Width="120" />
                   </StackPanel>
                </DataTemplate>
             </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

    </TabControl>

    <!-- Footer Status -->
    <Border Grid.Row="2" Background="#F8FAFC" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="PART_StatusMsg" Text="" Foreground="#F05922" VerticalAlignment="Center" FontSize="12"/>
      </Grid>
    </Border>
  </Grid>
</Window>
