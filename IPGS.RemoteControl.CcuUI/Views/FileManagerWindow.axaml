<Window Icon="avares://IPGS.RemoteControl.CcuUI/Assets/icon.png" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
        xmlns:local="clr-namespace:IPGS.RemoteControl.CcuUI.Views"
        x:Class="IPGS.RemoteControl.CcuUI.Views.FileManagerWindow"
        Title="Quản Lý File (SFTP)"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0" Background="#251C53" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="PART_TitleText" Text="Quản Lý File Chuyên Sâu" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Toolbar -->
    <Border Grid.Row="1" Background="#F8FAFC" Padding="12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,0">
        <kz:KzButton Grid.Column="0" x:Name="PART_BtnUp" Content="⬆ Lên 1 cấp" KzSize="Sm" Margin="0,0,8,0" Classes="kz-outline" />
        <kz:KzTextBox Grid.Column="1" x:Name="PART_TxtPath" Text="/" Margin="0,0,8,0" VerticalAlignment="Center" />
        <kz:KzButton Grid.Column="2" x:Name="PART_BtnGo" Content="Đi" KzSize="Sm" Classes="kz-primary" Margin="0,0,16,0" />

        <kz:KzButton Grid.Column="3" x:Name="PART_BtnRefresh" Content="🔄 Làm mới" KzSize="Sm" Margin="0,0,8,0" Classes="kz-outline" />
        <kz:KzButton Grid.Column="4" x:Name="PART_BtnSync" Content="🔄 Đồng bộ" KzSize="Sm" Classes="kz-outline" Margin="0,0,8,0" ToolTip.Tip="Đồng bộ thư mục cục bộ lên thư mục đích" />
        <kz:KzButton Grid.Column="5" x:Name="PART_BtnUpload" Content="⬆ Upload File" KzSize="Sm" Classes="kz-primary" Margin="0,0,8,0" />
        <kz:KzButton Grid.Column="6" x:Name="PART_BtnDelete" Content="🗑 Xóa" KzSize="Sm" Classes="kz-danger" />
      </Grid>
    </Border>

    <!-- File List -->
    <DataGrid Grid.Row="2" x:Name="PART_FileList" 
              AutoGenerateColumns="False" 
              CanUserSortColumns="True"
              IsReadOnly="True"
              GridLinesVisibility="All"
              BorderThickness="1" BorderBrush="#E2E8F0"
              Margin="12"
              SelectionMode="Extended"
              DragDrop.AllowDrop="True"
              x:DataType="local:SftpFileItem">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Tên File" Binding="{Binding Name}" Width="3*" />
        <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="*" />
        <DataGridTextColumn Header="Kích thước" Binding="{Binding SizeString}" Width="*" />
        <DataGridTextColumn Header="Ngày sửa" Binding="{Binding LastModifiedString}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Status Bar -->
    <Border Grid.Row="3" Background="#F1F5F9" Padding="12,6" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
      <TextBlock x:Name="PART_StatusMsg" Text="Sẵn sàng" Foreground="#475569" FontSize="12" />
    </Border>
  </Grid>
</Window>



