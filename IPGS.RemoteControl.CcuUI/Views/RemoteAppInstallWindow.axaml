<Window Icon="avares://IPGS.RemoteControl.CcuUI/Assets/icon.png" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
        x:Class="IPGS.RemoteControl.CcuUI.Views.RemoteAppInstallWindow"
        Title="📦 Cài đặt phần mềm từ xa"
        Width="640" Height="680"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0" Background="#251C53" Padding="20,16">
      <StackPanel Spacing="4">
        <TextBlock Text="📦 Cài đặt phần mềm từ xa (Upload &amp; Install)"
                   Foreground="White" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="Upload file .deb / .sh / .run và tự động cài đặt trên máy đích."
                   Foreground="#B8B3D6" FontSize="12" />
      </StackPanel>
    </Border>

    <!-- Content -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16" Margin="24,18">
        
        <!-- Target Info -->
        <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="🎯" FontSize="16"/>
            <StackPanel Spacing="2">
              <TextBlock x:Name="PART_TargetHostText" Text="Đang cài đặt cho: —" FontWeight="Bold" FontSize="13" Foreground="#3730A3"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="4">
          <TextBlock Text="Sudo password (nếu cần cấp quyền cài đặt, để trống nếu giống SSH password):" FontSize="12" Foreground="#64748B"/>
          <TextBox x:Name="PART_SudoPassword" PasswordChar="•" Height="36" VerticalContentAlignment="Center"/>
        </StackPanel>
        <!-- Install -->
        <StackPanel Spacing="4">
          <TextBlock Text="Cài đặt (chọn file .deb, .sh, .run):" FontSize="12" Foreground="#64748B"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="PART_AppInstallerPath" Watermark="Đường dẫn file..." Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" Height="36" VerticalContentAlignment="Center" />
            <Button x:Name="PART_BtnBrowseApp" Content="Duyệt File..." Grid.Column="1" Padding="16,8" />
          </Grid>
        </StackPanel>

        <!-- Uninstall -->
        <StackPanel Spacing="4">
          <TextBlock Text="Gỡ cài đặt (nhập tên package, VD: kztek-app):" FontSize="12" Foreground="#64748B"/>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <AutoCompleteBox x:Name="PART_UninstallPackageName" MinimumPrefixLength="0" Watermark="Tên package cần gỡ (gõ để tìm)..." Grid.Column="0" Margin="0,0,4,0" Height="36" FilterMode="Contains" />
            <Button x:Name="PART_BtnShowAll" Content="▼" Grid.Column="1" Margin="0,0,8,0" Height="36" Width="36" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            <Button x:Name="PART_BtnUninstall" Content="🗑️ Gỡ ứng dụng" Grid.Column="2" Padding="16,8" Foreground="White" Background="#EF4444" />
          </Grid>
        </StackPanel>

        <!-- Console Log -->
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="💻 Nhật ký cài đặt (Console Output):" Foreground="#475569" FontSize="13" FontWeight="SemiBold"/>
            <TextBox x:Name="PART_LogConsole"
                     Height="180"
                     Padding="12,12,12,32"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="#FFFFFF"
                     Foreground="#334155"
                     FontFamily="Consolas, Cascadia Code, Monospace"
                     FontSize="13"
                     BorderThickness="1"
                     BorderBrush="#CBD5E1"
                     CornerRadius="6"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" Background="#F8FAFC" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="PART_StatusMsg" Text="" Foreground="#F05922" VerticalAlignment="Center" FontSize="12"/>
        <kz:KzButton Grid.Column="1" x:Name="PART_BtnDeploy" Content="🚀 Bắt đầu Cài đặt" Classes="kz-primary"/>
      </Grid>
    </Border>

  </Grid>
</Window>



