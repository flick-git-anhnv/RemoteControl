<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
        xmlns:local="clr-namespace:IPGS.RemoteControl.CcuUI.Views"
        x:Class="IPGS.RemoteControl.CcuUI.Views.HealthMonitorWindow"
        Title="Dashboard - Giám Sát Sức Khỏe ZCU"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0" Background="#1E293B" Padding="20,16">
      <TextBlock x:Name="PART_TitleText" Text="Giám Sát Sức Khỏe - ZCU" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
    </Border>

    <!-- Main Content -->
    <ScrollViewer Grid.Row="1" Padding="20">
      <StackPanel Spacing="20">
        
        <!-- CPU & RAM & Disk Panel -->
        <Grid ColumnDefinitions="*,*,*">
          <!-- CPU -->
          <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Padding="16" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8" />
              <TextBlock x:Name="PART_CpuText" Text="--%" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
            </StackPanel>
          </Border>

          <!-- RAM -->
          <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="16" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="RAM" FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8" />
              <TextBlock x:Name="PART_RamText" Text="-- / -- MB" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
              <TextBlock x:Name="PART_RamPercentText" Text="--%" FontSize="14" Foreground="#64748B" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <!-- DISK -->
          <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Ổ cứng ( / )" FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8" />
              <TextBlock x:Name="PART_DiskText" Text="-- / --" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
              <TextBlock x:Name="PART_DiskPercentText" Text="--%" FontSize="14" Foreground="#64748B" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Top Processes -->
        <TextBlock Text="Top Process Đang Chạy" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5" />
        <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" MinHeight="150">
          <DataGrid x:Name="PART_ProcessList" 
                    AutoGenerateColumns="False" 
                    CanUserSortColumns="False" 
                    IsReadOnly="True" 
                    GridLinesVisibility="All" 
                    HeadersVisibility="Column"
                    x:DataType="local:ProcessItem">
            <DataGrid.Columns>
              <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
              <DataGridTextColumn Header="Người dùng" Binding="{Binding User}" Width="100" />
              <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu}" Width="80" />
              <DataGridTextColumn Header="RAM %" Binding="{Binding Mem}" Width="80" />
              <DataGridTextColumn Header="Lệnh (Command)" Binding="{Binding Command}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
        
      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" Background="#F8FAFC" Padding="12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock x:Name="PART_StatusMsg" Text="Đang kết nối..." VerticalAlignment="Center" Foreground="#64748B" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
          <kz:KzButton x:Name="PART_BtnRefresh" Content="🔄 Làm mới ngay" KzSize="Sm" Classes="kz-outline" />
          <kz:KzButton x:Name="PART_BtnClose" Content="Đóng" KzSize="Sm" Classes="kz-primary" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
