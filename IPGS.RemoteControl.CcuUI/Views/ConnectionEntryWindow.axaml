<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
        xmlns:ccu="clr-namespace:IPGS.RemoteControl.CcuClient;assembly=IPGS.RemoteControl.CcuClient"
        xmlns:conv="clr-namespace:IPGS.RemoteControl.CcuUI.Converters"
        x:Class="IPGS.RemoteControl.CcuUI.Views.ConnectionEntryWindow"
        Title="iPGS Remote Control — Danh sách máy tính ZCU"
        Width="1200" Height="760"
        WindowStartupLocation="CenterScreen"
        CanResize="True">

  <Window.Resources>
    <conv:ComputerStatusToBrushConverter x:Key="ComputerStatusToBrushConverter" />
    <conv:NullableBoolToStatusBrushConverter x:Key="NullableBoolToStatusBrushConverter" />
    <conv:NullableBoolIsTrueConverter x:Key="NullableBoolIsTrueConverter" />
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

    <!-- ── Header bar ─────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#251C53" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
          <TextBlock Text="iPGS Remote Control"
                     Foreground="White"
                     FontSize="16"
                     FontWeight="Bold" />
          <TextBlock Text="Quản lý danh sách máy tính &amp; Kết nối điều khiển ZCU"
                     Foreground="#D1C4E9"
                     FontSize="12" />
        </StackPanel>
        
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <kz:KzButton x:Name="PART_BtnScanNetwork" Content="🔍 Quét mạng..." />
          <kz:KzButton x:Name="PART_BtnMultiRemote" Content="🚀 Remote nhiều máy (Grid View)..." Classes="kz-primary" />
          <kz:KzButton x:Name="PART_BtnAddComputer" Content="+ Thêm máy tính" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Filter & Search Toolbar ────────────────────────────────── -->
    <Border Grid.Row="1" Background="#F4F5F8" Padding="16,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <kz:KzTextBox Grid.Column="0"
                      x:Name="PART_SearchBox"
                      Watermark="🔍 Tìm kiếm máy tính theo tên hoặc IP..."
                      Margin="0,0,12,0" />
        
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <kz:KzButton x:Name="PART_BtnTabAll"    Content="Tất cả máy tính" KzSize="Sm" />
          <kz:KzButton x:Name="PART_BtnTabRecent" Content="Lịch sử gần đây" KzSize="Sm" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── SSH requirement hint (dùng chung cho nút Cài remote / Setup) ──── -->
    <Border Grid.Row="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" Padding="16,8">
      <TextBlock FontSize="11" Foreground="#92400E" TextWrapping="Wrap">
        ⚠️ Yêu cầu: máy đích phải đã cài &amp; bật SSH server trước khi thao tác "⚡ Cài remote" / "🖥️ Setup" (nút tự bật khi phát hiện có SSH). Nếu chưa có, chạy trên máy đó: <Run FontFamily="Consolas, Monospace" Foreground="#78350F" Text="sudo apt update &amp;&amp; sudo apt install -y openssh-server &amp;&amp; sudo systemctl enable --now ssh"/>
      </TextBlock>
    </Border>

    <!-- ── Computer List View ─────────────────────────────────────── -->
    <Grid Grid.Row="3" Margin="16,12">
      <!-- Main Computer ListBox -->
      <ListBox x:Name="PART_ComputerListBox"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="ccu:ComputerProfile">
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Computer Icon Badge & CheckBox -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,14,0" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" IsCheckedChanged="OnSelectionChanged" />
                  <Border Width="42" Height="42"
                          CornerRadius="21"
                          Background="#EDE7F6"
                          VerticalAlignment="Center">
                    <TextBlock Text="💻"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>

                <!-- Info Details -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#212121"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#E8EAF6" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Host}" FontSize="11" Foreground="#3F51B5" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Icon trạng thái SSH -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding SshStatusTooltip}">
                      <Border Width="9" Height="9" CornerRadius="5"
                              Background="{Binding SshReachable, Converter={StaticResource NullableBoolToStatusBrushConverter}}"/>
                      <TextBlock Text="SSH" FontSize="10" Foreground="#757575" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Icon trạng thái Agent Remote Control (đã cài & đang chạy) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding AgentStatusTooltip}">
                      <Border Width="9" Height="9" CornerRadius="5"
                              Background="{Binding AgentReachable, Converter={StaticResource NullableBoolToStatusBrushConverter}}"/>
                      <TextBlock Text="Remote" FontSize="10" Foreground="#757575" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <!-- Health Badges -->
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding CpuUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding CpuUsage}" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding RamUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding RamUsage}" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding DiskUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding DiskUsage}" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding Port, StringFormat='Cổng: {0}'}"
                               FontSize="12"
                               Foreground="#616161"/>
                    <TextBlock Text="{Binding LastConnectedAt, StringFormat='Lần cuối: {0:dd/MM/yyyy HH:mm}'}"
                               FontSize="12"
                               Foreground="#757575"/>
                  </StackPanel>

                  <TextBlock Text="{Binding Notes}"
                             FontSize="11"
                             Foreground="#9E9E9E"
                             IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemWakeUpClick"
                               Content="⚡ Bật nguồn"
                               Classes="kz-outline"
                               ToolTip.Tip="Bật máy bằng Wake-on-LAN (Magic Packet)"
                               KzSize="Sm" />
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemConnectClick"
                               Content="Kết nối"
                               Classes="kz-primary"
                               IsEnabled="{Binding AgentReachable, Converter={StaticResource NullableBoolIsTrueConverter}}"
                               ToolTip.Tip="{Binding AgentStatusTooltip}"
                               KzSize="Sm" />
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemSetupWizardClick"
                               Content="⚡ Cài remote"
                               IsEnabled="{Binding SshReachable, Converter={StaticResource NullableBoolIsTrueConverter}}"
                               ToolTip.Tip="{Binding SshStatusTooltip}"
                               KzSize="Sm" />
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemAppInstallClick"
                               Content="📦 Cài App"
                               IsEnabled="{Binding SshReachable, Converter={StaticResource NullableBoolIsTrueConverter}}"
                               ToolTip.Tip="{Binding SshStatusTooltip}"
                               KzSize="Sm" />
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemFileManagerClick"
                               Content="📁 Quản lý File"
                               IsEnabled="{Binding SshReachable, Converter={StaticResource NullableBoolIsTrueConverter}}"
                               ToolTip.Tip="{Binding SshStatusTooltip}"
                               KzSize="Sm" />
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemHealthMonitorClick"
                               Content="📊 Giám sát"
                               IsEnabled="{Binding SshReachable, Converter={StaticResource NullableBoolIsTrueConverter}}"
                               ToolTip.Tip="{Binding SshStatusTooltip}"
                               KzSize="Sm" />
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemRunCommandClick"
                               Content="&gt;_ CMD Shell"
                               IsEnabled="{Binding SshReachable, Converter={StaticResource NullableBoolIsTrueConverter}}"
                               ToolTip.Tip="{Binding SshStatusTooltip}"
                               KzSize="Sm" />
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemKioskDeployClick"
                               Content="🖥️ Setup"
                               IsEnabled="{Binding SshReachable, Converter={StaticResource NullableBoolIsTrueConverter}}"
                               ToolTip.Tip="{Binding SshStatusTooltip}"
                               KzSize="Sm" />
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemEditClick"
                               Content="Sửa"
                               KzSize="Sm" />
                  <kz:KzButton Tag="{Binding}"
                               Click="OnItemDeleteClick"
                               Content="Xóa"
                               KzSize="Sm" />
                </StackPanel>

              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Empty state when no computer matches -->
      <StackPanel x:Name="PART_EmptyState"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  IsVisible="False">
        <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center"/>
        <TextBlock Text="Chưa có máy tính nào trong danh sách"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#757575"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Nhấn '+ Thêm máy tính' để lưu thông tin ZCU mới."
                   FontSize="12"
                   Foreground="#9E9E9E"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <!-- ── Floating Bulk Action Bar (Bottom) ────────────────────── -->
    <Border Grid.Row="4" x:Name="PART_BulkActionBar" Background="#1E293B" Padding="16,12" IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="PART_BulkActionText" Text="Đã chọn 0 máy tính" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <kz:KzButton Content="🚀 Gửi lệnh / Upload File Hàng Loạt" Classes="kz-primary" KzSize="Sm" Click="OnBulkActionClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Quick Connection Drawer Bar (Bottom) ────────────────────── -->
    <Border Grid.Row="5" Background="#F5F5F7" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,100,Auto,*,Auto" RowDefinitions="Auto">
        <TextBlock Grid.Column="0" Text="Kết nối nhanh:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
        <kz:KzTextBox Grid.Column="1" x:Name="PART_QuickHost" Watermark="IP (192.168.x.x)" Width="150" Margin="0,0,6,0"/>
        <kz:KzTextBox Grid.Column="2" x:Name="PART_QuickPort" Text="17600" Width="70" Margin="0,0,6,0"/>
        <kz:KzTextBox Grid.Column="3" x:Name="PART_QuickToken" Watermark="Token" Width="140" Margin="0,0,10,0"/>
        <CheckBox Grid.Column="4" x:Name="PART_QuickSaveCheck" Content="Lưu danh sách" IsChecked="True" VerticalAlignment="Center"/>
        <kz:KzButton Grid.Column="5" x:Name="PART_QuickConnectBtn" Content="Kết nối" Classes="kz-primary" KzSize="Sm"/>
      </Grid>
    </Border>

  </Grid>
</Window>
