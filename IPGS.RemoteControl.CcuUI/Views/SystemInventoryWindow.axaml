<Window Icon="avares://IPGS.RemoteControl.CcuUI/Assets/icon.png" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPGS.RemoteControl.CcuUI.Views.SystemInventoryWindow"
        Title="System Inventory"
        Width="450" Height="300"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20">
            <!-- CPU -->
            <StackPanel>
                <TextBlock Text="CPU" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock x:Name="PART_CpuText" Text="Loading..." FontSize="15" Foreground="#F8FAFC" TextWrapping="Wrap" />
            </StackPanel>
            
            <!-- Memory -->
            <StackPanel>
                <TextBlock Text="Memory (RAM)" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock x:Name="PART_MemText" Text="Loading..." FontSize="15" Foreground="#F8FAFC" />
            </StackPanel>

            <!-- OS -->
            <StackPanel>
                <TextBlock Text="Operating System" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock x:Name="PART_OsText" Text="Loading..." FontSize="15" Foreground="#F8FAFC" />
            </StackPanel>

            <!-- Architecture -->
            <StackPanel>
                <TextBlock Text="Architecture" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock x:Name="PART_ArchText" Text="Loading..." FontSize="15" Foreground="#F8FAFC" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
