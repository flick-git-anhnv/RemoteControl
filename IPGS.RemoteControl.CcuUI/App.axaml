<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IPGS.RemoteControl.CcuUI.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Load tokens first so KzButton/KzTextBox styles can resolve kz.brush.* keys -->
    <Styles>
      <Styles.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://KztekComponentAvalonia/Theme/KzTokens.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </Styles.Resources>
    </Styles>

    <!-- Giao diện chung (redesign): font, nút, header, bảng — sau KzTokens -->
    <StyleInclude Source="avares://IPGS.RemoteControl.CcuUI/Styles/AppTheme.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- ControlThemes: KzButton, KzTextBox, KzPasswordTextBox, ... -->
        <ResourceInclude Source="avares://KztekComponentAvalonia/Themes/Default.axaml" />
        <!-- Icon Lucide: key "ic.<tên>" dùng với controls:LucideIcon -->
        <ResourceInclude Source="avares://IPGS.RemoteControl.CcuUI/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
