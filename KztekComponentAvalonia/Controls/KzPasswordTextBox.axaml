<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:KztekComponentAvalonia.Controls"
             x:Class="KztekComponentAvalonia.Controls.KzPasswordTextBox"
             mc:Ignorable="d" 
             d:DesignWidth="280" d:DesignHeight="40">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://KztekComponentAvalonia/Theme/KzTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Xóa nền của TextBox khi Hover (di chuột vào) -->
        <Style Selector="TextBox#PART_Input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        
        <!-- Xóa nền của TextBox khi Focus (click con trỏ chuột vào) -->
        <Style Selector="TextBox#PART_Input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <Border Name="PART_Border"
            ClipToBounds="True"
            Background="{StaticResource kz.brush.white}"
            BorderBrush="{StaticResource kz.brush.border}"
            BorderThickness="1"
            CornerRadius="{StaticResource kz.radius.md}"
            MinHeight="{StaticResource kz.height.md}">
        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
            </Transitions>
        </Border.Transitions>

        <Grid ColumnDefinitions="*,40">

            <!-- Password input -->
            <TextBox Name="PART_Input"
                     Grid.Column="0"
                     PasswordChar="●"
                     PlaceholderText="Nhập mật khẩu"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12,0,0,0"
                     VerticalContentAlignment="Center"
                     CaretBrush="{StaticResource kz.brush.navy.900}"
                     SelectionBrush="{StaticResource kz.brush.orange.300}"
                     FontSize="{StaticResource kz.font.md}" />

            <!-- Eye toggle button -->
            <Button Name="PART_EyeBtn"
                    Grid.Column="1"
                    Classes="kz-btn-ghost"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Width="40"
                    Cursor="Hand"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">

                <Panel>
                    <!-- Eye OPEN icon (svg path) — shown when password is hidden -->
                    <Path Name="PART_EyeOpen"
                          Stretch="Uniform"
                          Width="18" Height="14"
                          Fill="{StaticResource kz.brush.text.muted}"
                          Data="M 1 8 C 3.5 3 6.5 1.5 12 1.5 C 17.5 1.5 20.5 3 23 8 C 20.5 13 17.5 14.5 12 14.5 C 6.5 14.5 3.5 13 1 8 Z M 12 5 C 9.791 5 8 6.791 8 9 C 8 11.209 9.791 13 12 13 C 14.209 13 16 11.209 16 9 C 16 6.791 14.209 5 12 5 Z M 10.5 9 C 10.5 8.172 11.172 7.5 12 7.5 C 12.828 7.5 13.5 8.172 13.5 9 C 13.5 9.828 12.828 10.5 12 10.5 C 11.172 10.5 10.5 9.828 10.5 9 Z" />

                    <!-- Eye SLASH icon — shown when password is visible -->
                    <Path Name="PART_EyeSlash"
                          IsVisible="False"
                          Stretch="Uniform"
                          Width="18" Height="14"
                          Stroke="{StaticResource kz.brush.text.muted}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          Data="M 1 8 C 3.5 3 6.5 1.5 12 1.5 C 17.5 1.5 20.5 3 23 8 C 20.5 13 17.5 14.5 12 14.5 C 6.5 14.5 3.5 13 1 8 Z M 2 2 L 22 14" />
                </Panel>
            </Button>
        </Grid>
    </Border>
</UserControl>