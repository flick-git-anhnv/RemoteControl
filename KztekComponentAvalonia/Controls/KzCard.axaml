<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls"
             x:Class="KztekComponentAvalonia.Controls.KzCard"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://KztekComponentAvalonia/Theme/KzTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Name="CardRoot"
          Background="{StaticResource kz.brush.white}"
          BorderBrush="{StaticResource kz.brush.border}"
          BorderThickness="1"
          CornerRadius="{StaticResource kz.radius.lg}"
          Padding="20"
          BoxShadow="{StaticResource kz.shadow.sm}">
    <Border.Transitions>
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
        <ThicknessTransition Property="Margin" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Border.Transitions>
    <StackPanel Spacing="12">

      <!-- Icon row -->
      <Border Name="IconContainer"
              IsVisible="False"
              Width="44"
              Height="44"
              CornerRadius="{StaticResource kz.radius.md}"
              Background="{StaticResource kz.brush.navy.100}"
              HorizontalAlignment="Left">
        <TextBlock Name="IconText"
                   Text=""
                   FontSize="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>

      <!-- Title -->
      <TextBlock Name="CardTitleText"
                 Text=""
                 FontSize="{StaticResource kz.font.lg}"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource kz.brush.navy.900}"
                 IsVisible="False"
                 TextWrapping="Wrap" />

      <!-- Description -->
      <TextBlock Name="CardDescText"
                 Text=""
                 FontSize="{StaticResource kz.font.md}"
                 Foreground="{StaticResource kz.brush.text.muted}"
                 IsVisible="False"
                 TextWrapping="Wrap" />

      <!-- Content slot -->
      <ContentPresenter Name="ContentSlot"
                        Content="{Binding $parent[kz:KzCard].CardContent}" />
    </StackPanel>
  </Border>
</UserControl>