<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls">
    <Design.PreviewWith>
        <Border Padding="40" Background="#E8EAF0" MinWidth="400" MinHeight="220">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="avares://KztekComponentAvalonia/Theme/KzTokens.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Border.Styles>
                <Style Selector="kz|KzCheckBox">
                    <Setter Property="Theme" Value="{DynamicResource {x:Type kz:KzCheckBox}}" />
                </Style>
            </Border.Styles>
            <StackPanel Spacing="16" VerticalAlignment="Center">
                <kz:KzCheckBox Content="Chưa chọn" />
                <kz:KzCheckBox Content="Đã chọn" IsChecked="True" />
                <kz:KzCheckBox Content="Vô hiệu hóa" IsEnabled="False" />
                <kz:KzCheckBox Content="Đã chọn – vô hiệu" IsChecked="True" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type kz:KzCheckBox}" TargetType="kz:KzCheckBox">
        <Setter Property="Cursor"   Value="Hand" />
        <Setter Property="FontSize" Value="{StaticResource kz.font.md}" />
        <Setter Property="Foreground" Value="{StaticResource kz.brush.text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Background="Transparent">

                    <!-- Indicator box -->
                    <Border Name="Indicator"
                            Width="18" Height="18"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource kz.radius.sm}"
                            Background="{StaticResource kz.brush.white}"
                            BorderBrush="{StaticResource kz.brush.border}"
                            BorderThickness="2">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background"   Duration="0:0:0.12" />
                                <BrushTransition Property="BorderBrush"  Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>

                        <!-- Check mark path -->
                        <Viewbox Name="Checkmark" IsVisible="False" Stretch="Uniform" Width="10" Height="10">
                            <Canvas Width="12" Height="12">
                                <Path Data="M 1 6 L 4.5 9.5 L 11 2"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- Label -->
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"
                                      Background="Transparent"
                                      RecognizesAccessKey="True" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <!-- ── Checked ── -->
        <Style Selector="^:checked /template/ Border#Indicator">
            <Setter Property="Background"  Value="{StaticResource kz.brush.navy.900}" />
            <Setter Property="BorderBrush" Value="{StaticResource kz.brush.navy.900}" />
        </Style>
        <Style Selector="^:checked /template/ Viewbox#Checkmark">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- ── Hover (unchecked) ── -->
        <Style Selector="^:pointerover /template/ Border#Indicator">
            <Setter Property="BorderBrush" Value="{StaticResource kz.brush.navy.700}" />
        </Style>

        <!-- ── Hover (checked) ── -->
        <Style Selector="^:checked:pointerover /template/ Border#Indicator">
            <Setter Property="Background"  Value="{StaticResource kz.brush.navy.hover}" />
            <Setter Property="BorderBrush" Value="{StaticResource kz.brush.navy.hover}" />
        </Style>

        <!-- ── Focus ── -->
        <Style Selector="^:focus /template/ Border#Indicator">
            <Setter Property="BoxShadow" Value="{StaticResource kz.shadow.focus}" />
        </Style>

        <!-- ── Disabled ── -->
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
