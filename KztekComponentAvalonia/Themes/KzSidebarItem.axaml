<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls"
                    xmlns:conv="using:Avalonia.Data.Converters">
    <Design.PreviewWith>
        <!-- Outer border nhạt; inner container giả lập nền sidebar navy.900 -->
        <Border Padding="40" Background="#E8EAF0" MinWidth="300" MinHeight="360">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="avares://KztekComponentAvalonia/Theme/KzTokens.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Border.Styles>
                <Style Selector="kz|KzSidebarItem">
                    <Setter Property="Theme" Value="{DynamicResource {x:Type kz:KzSidebarItem}}" />
                </Style>
            </Border.Styles>
            <!-- Sidebar container — nền navy.900 giống thực tế -->
            <Border Background="{DynamicResource kz.brush.navy.900}"
                    CornerRadius="8" Padding="8" Width="220"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="4">
                    <kz:KzSidebarItem ItemLabel="Tổng quan" ItemIcon="⌂" />
                    <kz:KzSidebarItem ItemLabel="Quản lý người dùng" ItemIcon="☰" />
                    <kz:KzSidebarItem ItemLabel="Cài đặt hệ thống" ItemIcon="⚙" />
                    <kz:KzSidebarItem ItemLabel="Nhật ký sự kiện" ItemIcon="☷" />
                </StackPanel>
            </Border>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type kz:KzSidebarItem}" TargetType="kz:KzSidebarItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource kz.brush.navy.300}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{StaticResource kz.radius.md}">
                    <Grid ColumnDefinitions="4,*">
                        <!-- Active indicator bar -->
                        <Border Name="PART_Indicator"
                                Grid.Column="0"
                                Width="3"
                                CornerRadius="2"
                                Background="Transparent"
                                Margin="-16,0,8,0"
                                VerticalAlignment="Stretch" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding ItemIcon}"
                                       IsVisible="{TemplateBinding ItemIcon, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="16"
                                       Width="20"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding ItemLabel}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Hover -->
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{StaticResource kz.brush.navy.700}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{StaticResource kz.brush.white}" />
        </Style>

        <!-- Selected/Active -->
        <Style Selector="^:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="{StaticResource kz.brush.navy.700}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{StaticResource kz.brush.white}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="{StaticResource kz.brush.orange.500}" />
        </Style>

        <!-- Pressed -->
        <Style Selector="^:pressed /template/ Border#PART_Root">
            <Setter Property="Background" Value="{StaticResource kz.brush.navy.900}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
